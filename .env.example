# Path to your Steam installation folder (the one that directly
# contains "userdata", "steamapps" and "config" subfolders).
#
# Typical locations:
#   Windows : C:/Program Files (x86)/Steam
#   macOS   : /Users/<you>/Library/Application Support/Steam
#   Linux   : /home/<you>/.local/share/Steam   (or ~/.steam/steam)
#
# On Windows/macOS with Docker Desktop, make sure this path (or its
# parent drive/folder) is allowed under Docker Desktop's
# Settings -> Resources -> File sharing.
#
# IMPORTANT: quit Steam before running this tool so screenshots.vdf
# isn't being written by both Steam and this tool at the same time.
STEAM_DIR=C:/Program Files (x86)/Steam

# Linux only: match the container's user to yours so written files are
# owned by you, not root or a random UID. Find yours with `id -u`/`id -g`.
# Safe to leave at the defaults on Windows/macOS.
PUID=1000
PGID=1000
